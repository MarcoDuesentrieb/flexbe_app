#!/bin/bash

ROOT_PATH="$(rospack find flexbe_app)"
NW="$ROOT_PATH/nwjs/nw"
if [ ! -x "$NW" ]; then
    ROOT_PATH=.
    NW="$ROOT_PATH/nwjs/nw"
fi
if [ ! -x "$NW" ]; then
    echo "Cannot run flexbe_app: $NW is not executable." >&2
    echo "Build flexbe_app or run: rosrun flexbe_app nwjs_install" >&2
    exit 1
fi

exec "$NW" --password-store=basic "$ROOT_PATH" "$@"
